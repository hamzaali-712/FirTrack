{
  "name": "fittrack",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "test:auth": "npm run test:auth --workspace server",
    "test:exercises": "npm run test:exercises --workspace server",
    "test:plans": "npm run test:plans --workspace server",
    "test:sessions": "npm run test:sessions --workspace server",
    "test:analytics": "node --test scripts/analytics.test.mjs",
    "test:db": "npm run test:db --workspace server",
    "seed:exercises": "npm run seed:exercises --workspace server",
    "generate:exercise-svg": "node scripts/generate-exercise-svg-studies.mjs",
    "test:exercise-svg": "node --test scripts/exercise-svg-studies.test.mjs",
    "test:3d-asset": "node --test scripts/3d-asset.test.mjs",
    "start": "npm run start --workspace server"
  }
}
